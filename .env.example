VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only values for Cloudflare Pages Functions / Workers.
# Do not expose these with a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=lanternavideo
# Video masters use 64 MiB multipart parts by default. Part URLs are minted just in time.
R2_MULTIPART_PART_SIZE_BYTES=67108864
R2_MULTIPART_PART_URL_TTL_SECONDS=3600

CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_STREAM_API_TOKEN=your-stream-api-token
CLOUDFLARE_STREAM_SIGNING_KEY_ID=your-stream-signing-key-id
CLOUDFLARE_STREAM_SIGNING_JWK=your-base64-encoded-stream-signing-jwk
# Optional. Cloudflare Stream customer subdomain code. If omitted, Lanterna uses iframe.videodelivery.net.
CLOUDFLARE_STREAM_CUSTOMER_CODE=
# Optional. Override the Stream iframe base URL.
CLOUDFLARE_STREAM_IFRAME_BASE_URL=
# Optional. Comma-separated hostnames only, or full URLs that will be normalized to hostnames.
CLOUDFLARE_STREAM_ALLOWED_ORIGINS=
# R2 source URL used by Stream /copy. Default is 24 hours; maximum is 7 days.
STREAM_COPY_SOURCE_TTL_SECONDS=86400

EMAIL_PROVIDER=resend
EMAIL_PROVIDER_API_KEY=your-resend-api-key
# RESEND_API_KEY is also accepted as a server-only alias for EMAIL_PROVIDER_API_KEY.
# Optional server-only full-access key for provider-side delivery status reads. Keep the send key send-only.
RESEND_READ_API_KEY=your-full-access-resend-api-key
# Use Lanterna <onboarding@resend.dev> for local Resend test sends until your sending domain is verified.
EMAIL_FROM=Lanterna <deliver@your-domain.com>
EMAIL_REPLY_TO=hello@your-domain.com
CONTACT_EMAIL=team@hellobower.com

APP_URL=http://127.0.0.1:5173
PUBLIC_DELIVERY_BASE_URL=https://deliver.your-domain.com

# Stripe platform billing and paid unlocks. Use restricted/test keys while developing.
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
# Leave false when local development shares the production database.
STRIPE_SANDBOX_WRITES_ENABLED=false
# Film sales stay disabled unless this is explicitly enabled after Connect approval.
FILM_SALES_ENABLED=true
# Platform webhook events: checkout.session.completed, checkout.session.expired,
# customer.subscription.created/updated/deleted, invoice.paid, and invoice.payment_failed.
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-signing-secret
# Connect webhook receives events created on studio payout accounts.
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_your-connect-webhook-signing-secret
# Optional. Defaults to US when creating a studio payout account.
STRIPE_CONNECT_DEFAULT_COUNTRY=US
