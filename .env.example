VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only values for Cloudflare Pages Functions / Workers.
# Do not expose these with a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=lanternavideo

CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_STREAM_API_TOKEN=your-stream-api-token
CLOUDFLARE_STREAM_SIGNING_KEY_ID=your-stream-signing-key-id
CLOUDFLARE_STREAM_SIGNING_JWK=your-base64-encoded-stream-signing-jwk
CLOUDFLARE_STREAM_DIRECT_UPLOADS_ENABLED=true
# Optional. Cloudflare Stream customer subdomain code. If omitted, Lanterna uses iframe.videodelivery.net.
CLOUDFLARE_STREAM_CUSTOMER_CODE=
# Optional. Override the Stream iframe base URL.
CLOUDFLARE_STREAM_IFRAME_BASE_URL=
# Optional. Comma-separated hostnames only, or full URLs that will be normalized to hostnames.
CLOUDFLARE_STREAM_ALLOWED_ORIGINS=
STREAM_UPLOAD_URL_TTL_SECONDS=3600

EMAIL_PROVIDER=resend
EMAIL_PROVIDER_API_KEY=your-resend-api-key
EMAIL_FROM=Lanterna <deliver@your-domain.com>
EMAIL_REPLY_TO=hello@your-domain.com

APP_URL=http://127.0.0.1:5173
PUBLIC_DELIVERY_BASE_URL=https://deliver.your-domain.com

# Stripe paid unlocks. Use restricted/test keys while developing.
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-signing-secret
