{
  "rules": [
    {
      "allowed": {
        "origins": [
          "http://127.0.0.1:5173",
          "http://localhost:5173",
          "https://lanterna.film",
          "https://www.lanterna.film",
          "https://deliver.lanterna.video"
        ],
        "methods": [
          "GET",
          "HEAD",
          "PUT"
        ],
        "headers": [
          "content-type"
        ]
      },
      "exposeHeaders": [
        "etag"
      ],
      "maxAgeSeconds": 3600
    }
  ]
}
